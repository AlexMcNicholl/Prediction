# Copy to .env for local runs; in CI set these as GitHub Secrets.
# NO SECRET IS REQUIRED to ingest Kalshi market data - the market-data
# endpoints are public. Everything below is optional.

# --- Notifications (optional) ---
SMTP_USERNAME=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=

# --- Optional model data sources ---
# Only needed if you wire a keyed weather/quote provider into config.yaml.
WEATHER_API_KEY=
QUOTE_API_KEY=

# --- Overrides (optional) ---
# SCREENER_CONFIG=config.yaml
# SCREENER_DB_PATH=data/screener.db
